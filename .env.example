# Frontend Environment Variables Template (LifeLink AI)
# Copy this file to .env and replace with your actual Firebase and Backend details

# Firebase Client Configuration (Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=lifelink-ai-emergency.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifelink-ai-emergency
VITE_FIREBASE_STORAGE_BUCKET=lifelink-ai-emergency.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Backend FastAPI URL
VITE_API_BASE_URL=http://localhost:8000
