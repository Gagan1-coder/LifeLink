# LifeLink AI - Backend Environment Configuration

# SMS Settings
# Options: "simulated" (default zero-cost testing), "fast2sms", "twilio"
SMS_PROVIDER=simulated

# Fast2SMS credentials (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio credentials (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Google Maps API (Optional, Overpass/OSM works out-of-the-box)
MAPS_API_KEY=

# LLM Providers for Agentic AI (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
